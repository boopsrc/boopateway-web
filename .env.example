# Endereço do gateway FacePay (o Vite repassa /api para cá, evitando CORS)
VITE_API_TARGET=https://apipay.depois.click
# true = usa a API simulada no navegador (sem backend). Também dá para ligar na Home.
VITE_DEMO=false
# HTTPS no dev server (certificado autoassinado). Necessário para a câmera no celular via IP da rede.
VITE_HTTPS=true
