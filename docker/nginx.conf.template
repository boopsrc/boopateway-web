# Acesso por http:// fora de localhost (ex.: celular pelo IP) vai para https://, senão a câmera não abre.
map "$scheme:$host" $boop_redirect_https {
    default                0;
    "~^http:(?!localhost$|127\.0\.0\.1$)" 1;
}

server {
    listen 80;
    # HTTPS: a câmera (getUserMedia) só funciona em contexto seguro fora de localhost.
    # Sem certificado montado, docker/gen-cert.sh gera um autoassinado na subida.
    listen 443 ssl;
    ssl_certificate     /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;
    server_name _;
    root /usr/share/nginx/html;

    # Fotos do rosto vão no multipart.
    client_max_body_size 10m;

    if ($boop_redirect_https) {
        return 302 https://$host:${HTTPS_PORT}$request_uri;
    }

    # Proxy para o gateway FacePay (equivale ao proxy /api do Vite em dev).
    location /api/ {
        proxy_pass ${API_TARGET}/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # O reconhecimento facial no parceiro pode demorar.
        proxy_connect_timeout 15s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # wasm precisa do MIME correto para streaming.
    location ~* \.wasm$ {
        types { application/wasm wasm; }
        add_header Cache-Control "public, max-age=604800";
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA: rotas do React Router caem no index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
